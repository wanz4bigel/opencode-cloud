            }
        ],
        "substype": subs_type,
        "text_search": "",
        "lang": "en"
    }
    
    res = send_api_request(api_key, path, payload, tokens["id_token"], "POST")
    if res["status"] != "SUCCESS":
        print("Failed to fetch store packages.")
        print(f"Error: {res}")
        return None
    
    return res