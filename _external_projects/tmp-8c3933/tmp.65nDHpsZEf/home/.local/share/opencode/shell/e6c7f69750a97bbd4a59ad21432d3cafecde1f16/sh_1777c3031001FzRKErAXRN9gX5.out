# ⏳ Penjaga 12 jam + klien WebSocket — status dari /marimo/llm/
import json as _json
from pathlib import Path as _Path

_HOLD = _Path("/marimo/llm/hold_status.json")
_WS = _Path("/marimo/llm/hold_ws_status.json")

if not _HOLD.exists():
    _view = mo.md("⏳ Penjaga 12 jam belum jalan — jalankan `python3 /marimo/llm/hold12.py`.")
else:
    _s = _json.loads(_HOLD.read_text())
    _frac = min(1.0, _s["elapsed_s"] / _s["cap_s"])
    _fill = int(round(_frac * 30))
    _bar = "█" * _fill + "░" * (30 - _fill)
    _ok = _s["last_local"] == "200" and _s["last_public"] == "200" and _s["last_exec"] == "200"

    if _WS.exists():
        _w = _json.loads(_WS.read_text())
        _ws_ok = bool(_w.get("connected"))
        _ws_txt = (
            f"{'🟢' if _ws_ok else '🔴'} `{_w.get('session') or '—'}`"
            f"{' · kiosk' if _w.get('kiosk') else ''}"
            f" · {_w.get('messages', 0)} pesan · {_w.get('pings', 0)} ping"
            f" · reconnect {_w.get('reconnects', 0)}"
            f" · sejak {str(_w.get('since') or '—')[11:]}"
        )
    else:
        _ws_ok = False
        _ws_txt = "belum jalan"

    _view = mo.md(
        f"### ⏳ Penjaga 12 jam · {'🟢 sehat' if _ok else '🟡 perlu dicek'}\n\n"
        f"`{_bar}` **{_frac * 100:.0f}%**\n\n"
        f"| | |\n|---|---|\n"
        f"| Uptime | {_s['elapsed_h']:.2f} jam / 12 jam |\n"
        f"| Sisa | **{_s['remaining_h']:.2f} jam** |\n"
        f"| Beat HTTP | {_s['beats']} · tiap {_s['interval_s'] // 60} menit (ambang idle molab 90 menit) |\n"
        f"| Terakhir | {_s['last_beat']} · local={_s['last_local']} molab={_s['last_public']} exec={_s['last_exec']} |\n"
        f"| Klien WS | {_ws_txt} |\n"
        f"| Status | {_s['state']} · pid {_s.get('pid', '?')} |\n"
    )
_view

