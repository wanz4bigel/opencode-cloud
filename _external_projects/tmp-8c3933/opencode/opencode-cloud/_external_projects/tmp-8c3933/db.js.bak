export function reseed() {
  db.exec("DELETE FROM videos; DELETE FROM categories;");
  CATEGORY_SEED.forEach(([name, slug], i) => {
    db.prepare("INSERT INTO categories (name, slug, ord) VALUES (?, ?, ?)").run(name, slug, i);
  });
  let minutesAgo = 25;
  SEED.forEach(([title, cat, tags, url, duration]) => {
    const target = resolve(url);
    const info = db
      .prepare(
        `INSERT INTO videos (title, slug, provider, url, embed, kind, duration, category_id, tags, views, added_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', ?))`
      )
      .run(
        title,
        uniqueSlug(slugify(title)),
        target.provider,
        target.direct,
        target.embed,
        target.kind,
        duration,
        categoryIdBySlug(cat),
        normalizeTags(tags),
        Math.floor(Math.random() * 90000) + 1500,
        `-${minutesAgo} minutes`
      );
    minutesAgo += 37 + Math.floor(Math.random() * 180);
    return info;
  });
}

if (countVideos() === 0) {
  reseed();
  console.log(`Seed selesai: ${countVideos()} video colmek dari host embed.`);
}
