          if (window.setElementDtParams) window.setElementDtParams('body', { is_login: 1, is_one_tap_login: 1 });
          if (window.setNavUserInfo) window.setNavUserInfo();

          if (lawRegion && !data.user.email_authorized) {
           return $('.user_sub_common_warp.follow_email').show();
          }

          if (!lawRegion) {
            return subscriptionApp();
          }
        }
      });
    }

    $('.user_sub_common_warp.follow_email .close_button').on('click', function () {
      $('.user_sub_common_warp.follow_email').hide();
