    $('.follow-but').click(debounce(function () {
      dtReport('follow-button-click', 'to-follow');
      var user = $$_$$.user;
      if (!user || !user.is_user_login) {
        if (window.initOneTap) {
          return window.initOneTap($$.oneTapTAfallback, handleCredentialResponse);
        } else {
          $$.oneTapTAfallback()
        }
