      if (user && user.is_user_login) {
        var isFollowed = !!($('.follow-but').attr('data-follow') === 'true');
        if (isFollowed) {
          return unsubscribeFollowApp();
        }

        if (user.reg_type !== 'SOCIAL' && !user.isVerifiedEmail) {
          return location.href= $$x_ll+'/account/email?show_tip=1';
        }

        if (lawRegion) {
          
          if (!user.email_authorized) {
            $('.user_sub_common_warp.follow_email .user_sub_common_content').show();
            $('.user_sub_common_warp.follow_email .sub_success_box').hide();
            return $('.user_sub_common_warp.follow_email').show();
          }
          
          if (user.email_authorized) {
            return subscriptionApp();
          }
        }
        
        if (!lawRegion) {
          return subscriptionApp();
        }
      }
    }));
