    console.log('bidsBackHandler', {
      bids,
      timedOut,
      winners,
    });

    if (winners.length === 0) {
      console.warn('No winners');
        var $container = $('#' + code).closest('[data-dt-ga-name]');
        
        if ($container.length) {
            var gaName = $container.data('dt-ga-name');
            var pos = '';
            if (gaName.indexOf('top') > -1) {
                pos = 'top';
            } else if (gaName.indexOf('middle') > -1) {
                pos = 'middle';
            } else if (gaName.indexOf('side') > -1) {
                pos = 'side';
            }

            if (pos) {
                window.apkpureBannerAdQueue.push({ position: pos, $container: $container })
            }
        }
    } else {
      renderWinnerAd(winners.filter(function (bid) { return bid.adUnitCode === code })[0]);
    }

    pbjs.removeAdUnit(code);
  };
}

function getInmobiAdUnit(eleWidth, plc) {
  return {
    code: 'inmobi_' + plc,
    mediaTypes: {
      banner: {
        sizes: INMOBI_AD_HEIGHT.map(function (height) {
          return [eleWidth, height];
        }),
      },
    },
    bids: [
      {
        bidder: 'inmobi',
        params: {
          plc: '' + plc,
        },
      },
    ],
  };
}

function loadInmobiAdUnit(plc) {
    return function () {
        var eleWidth = document.querySelector('#inmobi_' + plc).clientWidth;

        if (!eleWidth) return;

        var adUnit = getInmobiAdUnit(eleWidth, plc);

        pbjs.addAdUnits([adUnit]);
        pbjs.requestBids({
            adUnitCodes: [adUnit.code],
            bidsBackHandler: inmobiBidsHandler(adUnit.code),
            timeout: 5000,
        });
    }
}
