         dtReport('follow-button-click', 'cancel-follow');
        }
      });
    }

    function handleCredentialResponse(response) {
      $.ajax({
        xhrFields: {
          withCredentials: true
        },
        crossDomain: true,
        type: 'POST',
        url: 'https://i.apkpure.com/auth/v2/one-tap/verify',
        data: {
          credential: response.credential,
        },
        success: function (data) {
          if (!data.user) return;
          $$_$$.user = data.user;
