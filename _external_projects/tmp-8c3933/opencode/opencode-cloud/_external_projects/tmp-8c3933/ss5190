        </div>






        <div class="d-flex justify-content-between align-items-center mb-3">


            <div>

                <input

                    type="checkbox"

                    name="remember">


                <span class="small">

                    Ingat saya

                </span>

            </div>



            <span class="small text-muted">Gunakan NISN/NIP dan password yang terdaftar.</span>



        </div>







        <button

            class="btn btn-success w-100 rounded-3">


            <i class="bi bi-box-arrow-in-right"></i>

            Login


        </button>





    </form>

                
                <div class="login-footer">

                    &copy; 2026 SMAN 1 Cigombong

                    <div class="footer-subtitle">
                        Sistem Pembelajaran Digital Sekolah
                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>