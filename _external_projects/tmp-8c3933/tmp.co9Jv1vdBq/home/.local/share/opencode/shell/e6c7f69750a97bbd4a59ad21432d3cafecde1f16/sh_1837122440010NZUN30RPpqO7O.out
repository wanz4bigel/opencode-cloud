{"type":"tool","id":"call_e5c93363e0c94a0496150eb8","name":"write","executed":false,"state":{"status":"completed","input":{"content":"// Kenali host video dari URL yang ditempel. Tidak ada upload: yang kita simpan\n// cuma alamat, dan pemutar video tetap di server host aslinya.\n\nconst DIRECT_FILE = /\\.(mp4|webm|ogv|ogg|m3u8|mov)(\\?|#|$)/i;\n\nconst PROVIDER_LABEL = {\n  youtube: \"YouTube\",\n  bitchute: \"Bitchute\",\n  xhamster: \"XHamster\",\n  xnxx: \"XNXX\",\n  ivideopop: \"iVideoPop\",\n  vimeo: \"Vimeo\",\n  facebook: \"Facebook\",\n  file: \"File langsung\",\n  streamtape: \"StreamTape\",\n  upcloud: \"UpCloud\",\n  mixdrop: \"Mixdrop\",\n  dood: \"Dood\",\n  lain: \"Eksternal\"\n};\n\nconst NO_FRAME = new Set([\"streamtape\", \"upcloud\", \"mixdrop\", \"dood\"]);\n\nexport function labelOf(provider) {\n  return PROVIDER_LABEL[provider] || PROVIDER_LABEL.lain;\n}\n\n/** Host ini biasanya menolak di-iframe, jadi tautan langsung lebih andal. */\nexport function blocksFraming(provider) {\n  return NO_FRAME.has(provider);\n}\n\nfunction idFrom(match) {\n  return match ? match[1] : null;\n}\n\n/**\n * @returns {{provider:string, embed:string, kind:('iframe'|'video'), direct:
