        <script>
                var ScrollDebounce = true;
                var page =1;
                var total_pages = 3;
    
                $('document').ready(function () {
                   // show_debug_width();
                    hover_video();
//                    scrool_header();
                    slider_menu();
                    dark_mode();
                    hover_menu_desktop();
                    hover_menu_burger();
                    loadOwl();
                    
                    
                     $(window).scroll(sticky_relocate);
                     //sticky_relocate();
                    
                });

                 function sticky_relocate() {
                    var window_top = $(window).scrollTop();
                    
                 
                                     var loader_height = $("#loader").height();
                
                    //var loader_height = $("#loader").height();
                    var loader_top  = $('#loader').position().top -600;
                    var ajaxURL     = "home";
    
    // console.log("lh" +loader_height);
    // console.log("lt" + (parseInt(loader_top)));
    // console.log(window_top);
                    if(window_top  >= loader_top) {
                        console.log(page);
                        if (ScrollDebounce) {
                          page++;
                          if(page < total_pages) {
                            ScrollDebounce = false;                   
                                  loadData(page,ajaxURL);
                          }
                        }
                    }
                   
               }

                    /*Load more Function*/
              function loadData(page,ajaxURL) {
                    $( ".loader" ).css( "display","block" );
                    $.ajax({
                            method: "POST",
                            url: "https://sukabumiupdate.com/ajax/" + ajaxURL,
                            data: { page: page,kid: 0 }
                    })
                    .done(function( content ) {
                      ScrollDebounce = true;      
                            $( ".loader" ).css( "display","none" );
                            $("#posts-infinite").append(content);
                            loadOwl();
                    });

                }
                function hover_menu_burger() {
                    $('.menu-mobile li').hover(function () {
                        $(this).find('ul.menu-hover').stop(true, true).delay(100).fadeIn(500);
                    }, function () {
                        $(this).find('ul.menu-hover').stop(true, true).delay(100).fadeOut(500);
                    });
                }
                function hover_menu_desktop() {
                    $('.header-menu-deskt li').hover(function () {
                        $(this).find('ul.submenu').stop(true, true).delay(100).fadeIn(500);
                    }, function () {
                        $(this).find('ul.submenu').stop(true, true).delay(100).fadeOut(500);
                    });
                }
                function slider_menu() {
                    $(document).ready(function () {

                        $("#owl-slider-headline").owlCarousel({
                            navigation: true, // Show next and prev buttons
                            slideSpeed: 300,
                            paginationSpeed: 400,
                            loop: true,
                            autoplay: true,
                            speed: 800,
                            pagination: false,
                            autoPlay: 5000, //Set AutoPlay to 10 seconds
                            timeout: 1000, // 5 seconds
                            items: 2,
                            // itemsDesktop: false,
                            // itemsDesktopSmall: false,
                            // itemsTablet: false,
                            // itemsMobile: false,
                            lazyLoad: true,
                            margin:10,
            						    nav:true,
            						    responsive:{
            						        0:{
            						            items:1
            						        },
            						        1000:{
            						            items:2
            						        }
            						    },
                            navigationText: ['<span class="fa fa-angle-left"></span>', '<span class="fa fa-angle-right"></span>']

                        });
                        $("#owl-slider-headline-category").owlCarousel({
                            navigation: true, // Show next and prev buttons
                            slideSpeed: 300,
                            paginationSpeed: 400,
                            loop: true,
                            lazyLoad: true,
                            autoplay: true,
                            speed: 800,
                            pagination: false,
                            autoPlay: 5000, //Set AutoPlay to 10 seconds
                            timeout: 1000, // 5 seconds
                            items: 1,
                            // itemsDesktop: false,
                            // itemsDesktopSmall: false,
                            // itemsTablet: false,
                            // itemsMobile: false,
                            margin:10,
                            nav:true,
                            responsive:{
                                0:{
                                    items:1
                                },
                                1000:{
                                    items:1
                                }
                            },
                            navigationText: ['<span class="fa fa-angle-left"></span>', '<span class="fa fa-angle-right"></span>']

                        }); 
                        $("#owl-slider-multimedia").owlCarousel({
                            navigation: false, // Show next and prev buttons
                            slideSpeed: 300,
                            paginationSpeed: 400,
                            loop: false,
                            lazyLoad: true,
                            autoplay: false,
                            speed: 800,
                            pagination: false,
                            autoPlay: 5000, //Set AutoPlay to 10 seconds
                            timeout: 1000, // 5 seconds
                            items: 3,
                            // itemsDesktop: false,
                            // itemsDesktopSmall: false,
                            // itemsTablet: false,
                            // itemsMobile: false,
                            margin:10,
                            nav:true,
                            responsive:{
                                0:{
                                    items:1
                                },
                                1000:{
                                    items:3
                                }
                            },
                            navigationText: ['<span class="fa fa-angle-left"></span>', '<span class="fa fa-angle-right"></span>']

                        });
                      

                    });

                }

                function hover_video() {
                    $('div.video-cover').hover(function () {
                        $(this).find('div.overplay').show();
                        $('div.video-cover img').css({
                            "opacity": "0.9"
                        });
                    });
                    


                
                    $(document).ready(function() {
     
                        $(".fa-search").click(function() {
                           $(".search-box").toggle();
                           $("input[type='text']").focus();
                         });
                 
                    });

                      $('#mySelect').on('change', function (e) {
                            $('#myTab li a').eq($(this).val()).tab('show');
                        });
                }
      function loadOwl() {
                        $('.owl-slider-category1').each(function(){
                          $(this).owlCarousel({
                              navigation: true, // Show next and prev buttons
                              slideSpeed: 300,
                              paginationSpeed: 400,
                              loop: true,
                              autoplay: false,
                              pagination: false,
                              lazyLoad: true,
                              navigationText: ['<span class="fa fa-angle-left"></span>', '<span class="fa fa-angle-right"></span>'],
                              speed: 800,
                              items: 1,
                              itemsDesktop: false,
                              itemsDesktopSmall: false,
                              itemsTablet: false,
                              itemsMobile: false

                          });
                        });
                      }
                //mobile menu/nav
                function mobSidenav() {
                    document.getElementById("mobSidenav").style.width = "100%";
                    $('span#icon-menu ').hide();
                }
                function mobcloseNav() {
                    document.getElementById("mobSidenav").style.width = "0";
                    $('span#icon-menu ').show();
                }

                function dark_mode() {

                    window.console = window.console || function (t) {};
                    if (document.location.search.match(/type=embed/gi)) {
                        window.parent.postMessage("resize", "*");
                    }
                    //console.log('Ka.');
                    const toggleSwitch = document.querySelector('.theme-switch input[type="checkbox"]');
                    function switchTheme(e) {
                        if (e.target.checked) {
                            document.documentElement.setAttribute('data-theme', 'dark');
                            localStorage.setItem('theme', 'dark'); //add this
                            $('.change-logo').attr('src','/themes/supdate/css/img/logo-putih.png').delay(1);
                            //$('#change-logo-bottom').attr('src','/themes/supdate/css/img/logo-putih.png').delay(1);
               
                        } else {
                            document.documentElement.setAttribute('data-theme', 'light');
                             localStorage.setItem('theme', 'light'); //add this
                             //$('#change-logo-bottom').attr('src','/themes/supdate/css/img/logo.png');
                             $('.change-logo').attr('src','/themes/supdate/css/img/logo.png');
                        }
                    }
                    function switchLogo(e) {
                        if (e) {
                            $('.change-logo').attr('src','/themes/supdate/css/img/logo-putih.png').delay(1);
               
                        } else {
                             $('.change-logo').attr('src','/themes/supdate/css/img/logo.png');
                        }
                        toggleSwitch.checked = (localStorage.getItem('theme') == "dark") ? true : false;
                    }
                    toggleSwitch.addEventListener('change', switchTheme, false);
                    const currentTheme = localStorage.getItem('theme') ? localStorage.getItem('theme') : null;
                    document.documentElement.setAttribute('data-theme', currentTheme);
                    switchLogo(localStorage.getItem('theme') == "dark" ? true : false);

                }

              function copy(str) {
                const el = document.createElement('textarea');
                el.value = str;
                document.body.appendChild(el);
                el.select();
                document.execCommand('copy');
                document.body.removeChild(el);
                alert("URL telah disalin");
