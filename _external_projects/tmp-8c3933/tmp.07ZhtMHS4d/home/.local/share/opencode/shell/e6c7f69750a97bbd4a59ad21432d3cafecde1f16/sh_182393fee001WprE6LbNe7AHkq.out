function applyInputSettings() {
  if (touch) {
    touch.sensitivity = settings.sensitivity;
    touch.invertY = settings.invertY;
  }
  if (keyboard) {
    keyboard.sensitivity = settings.sensitivity;
    keyboard.invertY = settings.invertY;
  }
}

