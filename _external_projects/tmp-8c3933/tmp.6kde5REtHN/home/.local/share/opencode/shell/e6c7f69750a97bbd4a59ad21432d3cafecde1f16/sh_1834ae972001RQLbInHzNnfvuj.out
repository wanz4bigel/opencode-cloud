443-function rasioPoster(v) {
444-  const r = Number(v.rasio) || 0;
445-  if (r > 0 && r < 10) return r;
446-  const l = Number(v.lebar) || 0;
447-  const t = Number(v.tinggi) || 0;
448-  return l > 0 && t > 0 ? l / t : 0;
