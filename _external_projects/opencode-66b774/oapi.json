{"openapi":"3.1.0","info":{"title":"alyx broker","version":"0.1.0"},"paths":{"/api/health":{"get":{"summary":"Health","operationId":"health_api_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/messages":{"post":{"summary":"Anthropic Messages Api","description":"Anthropic Messages compatibility endpoint.\n\nThis lets Claude Code route model traffic through Alyx with\n`ANTHROPIC_BASE_URL`. The first implementation is intentionally a\ntext-generation bridge: it accepts Anthropic message shape and streaming\nSSE, dispatches to Alyx workers, and returns Anthropic-shaped text blocks.","operationId":"anthropic_messages_api_v1_messages_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/signup":{"post":{"summary":"Signup Api","operationId":"signup_api_api_signup_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignupRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/login":{"post":{"summary":"Login Api","operationId":"login_api_api_login_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/logout":{"post":{"summary":"Logout Api","operationId":"logout_api_api_logout_post","parameters":[{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/me":{"get":{"summary":"Me Api","operationId":"me_api_api_me_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/keys":{"post":{"summary":"Create Api Key Api","description":"Mint a new API key. The full key is returned ONCE in this\nresponse and never again — UI must show + let the user copy it\nbefore it's lost.","operationId":"create_api_key_api_api_keys_post","parameters":[{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyCreateRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"summary":"List Api Keys Api","description":"List the caller's API keys. Prefix only, never the full key.","operationId":"list_api_keys_api_api_keys_get","parameters":[{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/keys/{key_id}":{"delete":{"summary":"Revoke Api Key Api","description":"Revoke (soft-delete) one of the caller's API keys. The row is\nkept for audit; the hash stops matching live traffic immediately.","operationId":"revoke_api_key_api_api_keys__key_id__delete","parameters":[{"name":"key_id","in":"path","required":true,"schema":{"type":"integer","title":"Key Id"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations":{"post":{"summary":"New Conversation Api","description":"Create an empty conversation, return its id. Persistent (SQLite);\nevery turn is classified by a router model that decides whether to\nground the answer in trusted-source search results — the client\nnever has to pick a mode or know the difference between 'chat' and\n'med'.","operationId":"new_conversation_api_api_conversations_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"summary":"List Conversations Api","description":"List the user's conversations, newest first, for the sidebar.","operationId":"list_conversations_api_api_conversations_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{cid}":{"get":{"summary":"Get Conversation Api","description":"Load a conversation's full message history. 404 if it doesn't\nexist OR belongs to another user (don't leak existence).","operationId":"get_conversation_api_api_conversations__cid__get","parameters":[{"name":"cid","in":"path","required":true,"schema":{"type":"string","title":"Cid"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Conversation Api","description":"Delete a conversation + its messages. 404 if it didn't exist\nor wasn't ours. Also wipes any uploaded attachments belonging to\nthis conversation — HIPAA principle: deleting the chat deletes its\nartifacts. Errors removing the dir are logged but don't fail the\nrequest (the SQLite row is already gone).","operationId":"delete_conversation_api_api_conversations__cid__delete","parameters":[{"name":"cid","in":"path","required":true,"schema":{"type":"string","title":"Cid"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/memories":{"get":{"summary":"List Memories Api","description":"All of the calling user's memories, grouped client-side by kind.","operationId":"list_memories_api_api_memories_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"summary":"Add Memory Api","description":"User-created memory (UI add). Kind is normalized to one of the\nfour known buckets — anything else becomes 'personal'.","operationId":"add_memory_api_api_memories_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MemoryCreate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Clear Memories Api","description":"Wipe all of the user's memories. Returns count removed.","operationId":"clear_memories_api_api_memories_delete","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/memories/{memory_id}":{"put":{"summary":"Update Memory Api","description":"User-edited memory content.","operationId":"update_memory_api_api_memories__memory_id__put","parameters":[{"name":"memory_id","in":"path","required":true,"schema":{"type":"integer","title":"Memory Id"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MemoryUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Memory Api","operationId":"delete_memory_api_api_memories__memory_id__delete","parameters":[{"name":"memory_id","in":"path","required":true,"schema":{"type":"integer","title":"Memory Id"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/uploads/{cid}/{filename}":{"get":{"summary":"Get Upload Api","description":"Serve a previously-uploaded attachment back to its owner. The\nconversation must exist + belong to this user (we reuse convstore.get\nas the authz check — 404 if not, never 403, so existence doesn't\nleak). The cid is enforced to be lowercase-hex and the filename is\nchecked for path traversal — nothing outside the conversation's own\nuploads dir can be reached.","operationId":"get_upload_api_api_uploads__cid___filename__get","parameters":[{"name":"cid","in":"path","required":true,"schema":{"type":"string","title":"Cid"}},{"name":"filename","in":"path","required":true,"schema":{"type":"string","title":"Filename"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/conversations/{cid}/pin":{"patch":{"summary":"Pin Conversation Api","description":"Pin or unpin a conversation. Pinned conversations float to the\ntop of the sidebar list (sorted before unpinned ones, then by\nupdated_at). 404 if the conversation doesn't exist or wasn't ours.","operationId":"pin_conversation_api_api_conversations__cid__pin_patch","parameters":[{"name":"cid","in":"path","required":true,"schema":{"type":"string","title":"Cid"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PinRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/generate":{"post":{"summary":"Generate Api","description":"Append the user's prompt to the named conversation, run a router\nmodel to decide whether a fresh trusted-source search is needed,\ndispatch the accumulated history to a chat-capable worker, stream\ntokens back as SSE, and tack the assistant's reply onto the same\nconversation when it finishes. The client no longer picks a 'type'\n— the router does. See _route_query().\n\nSTATELESS MODE. Omit `conversation_id` and none of that persistence\nhappens: no conversation row, no message rows, no title, no\nconversation type, no memory extraction, no saved upload. The caller\npasses whatever prior turns it wants in `messages` and gets back the\nsame SSE stream. Everything else — auth, Alyx's identity and safety\nsystem prompts, the router, search, the bibliography and prompt-leak\nfilters, the error event shape — is identical between the two modes.\n\nIt's for callers that already hold the transcript in their own store\nand only need an answer: they send a bounded window instead of\ngrowing a mirrored conversation into the model's context limit, and\nAlyx keeps no second copy of their users' text. See _TurnStore for\nwhy that's the stronger position for this broker, not a weaker one.","operationId":"generate_api_api_generate_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/extract":{"post":{"summary":"Extract Api","description":"Pull text out of a PDF or text-like document so it can be attached\nto a chat turn. Also persists the ORIGINAL file under the\nconversation's uploads dir so the bubble can show the actual PDF/doc\non reload. Returns {name, text, chars, file_ref}. Audio files do\nNOT go through here — they have their own /api/transcribe pipeline.","operationId":"extract_api_api_extract_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_extract_api_api_extract_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/transcribe":{"post":{"summary":"Transcribe Api","description":"Accept an audio upload, dispatch to an stt-capable worker, stream the\ntranscript back as SSE. The final SSE event is the Done message carrying\nthe structured TranscriptResult (text, segments, words, language, duration).\n\nIf `conversation_id` is provided AND owned by the caller, the original\naudio is persisted under that conversation's uploads dir, and the\nfirst SSE event emitted is a `{type: \"file_ref\"}` with the saved\nfilename — the client uses that to attach the audio file to the\neventual /api/generate call so the bubble can show it on reload.\n\nThe client is expected to make a separate POST to /api/generate if\nthey want a SOAP note generated from the edited transcript — the\nbroker does NOT auto-chain.","operationId":"transcribe_api_api_transcribe_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_transcribe_api_api_transcribe_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/voices":{"get":{"summary":"Voices Api","description":"Return the voice catalog. The UI currently locks the voice to\nAlyx's canonical bf_isabella and doesn't render the catalog, but\nthis endpoint stays around for future flexibility / admin tooling.","operationId":"voices_api_api_voices_get","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/speak":{"post":{"summary":"Speak Api","description":"Synthesize speech for `text` with the named voice. Streams base64-\nencoded int16 PCM frames via SSE as the TTS engine produces them on\nthe worker. Client decodes + queues each frame in Web Audio for\ngapless playback.","operationId":"speak_api_api_speak_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SpeakRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Index","description":"SPA shell — gated. Unauthenticated → /login; authenticated →\nindex.html. Cache-Control: no-store so an update to index.html lands\non the next reload.","operationId":"index__get","parameters":[{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/login":{"get":{"summary":"Login Page","description":"Login + signup page. If already authenticated, bounce to /.","operationId":"login_page_login_get","parameters":[{"name":"alyx_session","in":"cookie","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Alyx Session"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/docs":{"get":{"summary":"Api Docs Page","description":"Public API documentation — static HTML, no auth required so\nintegrators can read it without a session. Lists the endpoints\nexposed via Bearer-token auth (alyx_sk_… keys).","operationId":"api_docs_page_api_docs_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"ApiKeyCreateRequest":{"properties":{"name":{"type":"string","title":"Name"}},"type":"object","required":["name"],"title":"ApiKeyCreateRequest"},"Attachment":{"properties":{"name":{"type":"string","title":"Name"},"kind":{"type":"string","title":"Kind"},"data_b64":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Data B64"},"text":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Text"},"file_ref":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"File Ref"},"mime":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Mime"}},"type":"object","required":["name","kind"],"title":"Attachment","description":"A single attachment on a user turn. Three kinds:\n- image: `data_b64` carries the raw image bytes (base64); the\n  broker decodes + persists, and forwards the b64 to the worker\n  for the vision pipeline to slot in as a multimodal part.\n- document: `text` carries the extracted body that gets inlined\n  into the prompt as a <document> block. `file_ref` (if present)\n  names the original file on disk from a prior /api/extract call\n  so the bubble can show the actual PDF on reload.\n- audio: same shape as `document` — `text` is the transcript;\n  `file_ref` names the original audio file from /api/transcribe."},"Body_extract_api_api_extract_post":{"properties":{"file":{"type":"string","contentMediaType":"application/octet-stream","title":"File"},"conversation_id":{"type":"string","title":"Conversation Id"}},"type":"object","required":["file","conversation_id"],"title":"Body_extract_api_api_extract_post"},"Body_transcribe_api_api_transcribe_post":{"properties":{"audio":{"type":"string","contentMediaType":"application/octet-stream","title":"Audio"},"conversation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Conversation Id"},"language":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Language","default":"en"},"word_timestamps":{"type":"boolean","title":"Word Timestamps","default":true},"stream":{"type":"boolean","title":"Stream","default":true}},"type":"object","required":["audio"],"title":"Body_transcribe_api_api_transcribe_post"},"GenerateRequest":{"properties":{"conversation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Conversation Id"},"messages":{"items":{"$ref":"#/components/schemas/InlineMessage"},"type":"array","title":"Messages","default":[]},"prompt":{"type":"string","title":"Prompt"},"max_new_tokens":{"type":"integer","title":"Max New Tokens","default":4096},"voice":{"type":"boolean","title":"Voice","default":false},"attachments":{"items":{"$ref":"#/components/schemas/Attachment"},"type":"array","title":"Attachments","default":[]},"kind":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Kind"},"search":{"type":"boolean","title":"Search","default":false},"use_memories":{"type":"boolean","title":"Use Memories","default":false}},"type":"object","required":["prompt"],"title":"GenerateRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"InlineMessage":{"properties":{"role":{"type":"string","title":"Role"},"content":{"type":"string","title":"Content"}},"type":"object","required":["role","content"],"title":"InlineMessage","description":"One prior turn supplied by the caller on a stateless request.\n\n`role` is system / user / assistant. System entries are hoisted out\nof the transcript and appended to Alyx's own system block — see\ngenerate_api()."},"LoginRequest":{"properties":{"email":{"type":"string","title":"Email"},"password":{"type":"string","title":"Password"}},"type":"object","required":["email","password"],"title":"LoginRequest"},"MemoryCreate":{"properties":{"kind":{"type":"string","title":"Kind"},"content":{"type":"string","title":"Content"}},"type":"object","required":["kind","content"],"title":"MemoryCreate"},"MemoryUpdate":{"properties":{"content":{"type":"string","title":"Content"}},"type":"object","required":["content"],"title":"MemoryUpdate"},"PinRequest":{"properties":{"pinned":{"type":"boolean","title":"Pinned"}},"type":"object","required":["pinned"],"title":"PinRequest"},"SignupRequest":{"properties":{"invite_code":{"type":"string","title":"Invite Code"},"email":{"type":"string","title":"Email"},"password":{"type":"string","title":"Password"}},"type":"object","required":["invite_code","email","password"],"title":"SignupRequest"},"SpeakRequest":{"properties":{"text":{"type":"string","title":"Text"},"voice":{"type":"string","title":"Voice","default":"bf_isabella"}},"type":"object","required":["text"],"title":"SpeakRequest"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}